# ─── Locus · environment ───────────────────────────────────────────────
# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Optional: Google sign-in (Google Identity Services, ID-token flow — no client secret needed)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: canonical origin used for auth email redirects (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=

# Migrations only (npm run db:migrate) — set ONE of these, never commit real values
DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
